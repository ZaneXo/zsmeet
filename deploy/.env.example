# 复制成 .env 再改。只有前两项必须填。

# 数据库密码。用 `openssl rand -hex 16` 生成，只用字母和数字（它会被拼进连接地址里）
POSTGRES_PASSWORD=

# 用来加密保存在数据库里的凭证（大模型的 API Key 等）。用 `openssl rand -hex 32` 生成。
# 设好以后不要改：改了，之前保存的凭证就解不开，要在网页里重新填
ZSMEET_SECRET_KEY=

# 网页的访问端口
ZSMEET_PORT=8080

# 通过 HTTPS 访问时改成 true，登录 Cookie 只会在加密连接里发送
ZSMEET_SECURE_COOKIE=false

# 前面的 HTTPS 反向代理连过来的地址，用逗号隔开的网段或 IP。只有从这些地址来的请求，
# 才相信 X-Forwarded-For 里记的访问者 IP（按 IP 限制输错密码的次数要用）。不填只信本机。
# 代理装在这台机器上、用 docker compose 部署时，代理是从 Docker 网桥的网关连进来的：
# 填网关的地址（docker network inspect zsmeet_default 里的 Gateway），同时把上面的 ZSMEET_PORT 改成 127.0.0.1:8080，
# 让端口只有本机的代理能连。Nginx 要加 proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; Caddy 默认就带
# ZSMEET_TRUSTED_PROXIES=172.18.0.1

# 时区：纪要里的会议时间按它写
TZ=Asia/Shanghai

# 识别模型从哪里下载。huggingface.co 连不上时会自动换 hf-mirror.com，
# 在国内可以直接设成镜像，省掉一次超时等待
# ZSMEET_MODEL_MIRROR=https://hf-mirror.com

# 识别用几个 CPU 线程、同时处理几场会议（识别仍然一场一场来，并行的是写纪要）
# ZSMEET_ASR_THREADS=4
# ZSMEET_CONCURRENCY=2

# 识别的语言：zh（默认，中文会议里夹着英文也能认）、en、ja、ko、yue，或者 auto（每一小段自动判断，
# 很短的「嗯」「哦」会被认成日文，中文团队不要用）
# ZSMEET_ASR_LANGUAGE=zh

# 私有化部署的飞书：开放平台的地址（一般不用设，在网页上选飞书或 Lark 就行）
# ZSMEET_FEISHU_BASE_URL=https://open.your-feishu.example.com

# ---- 用发布好的镜像（不在这台机器上构建）----
# 版本号见 https://github.com/ZaneXo/zsmeet/releases。设了以后，启动和升级都用
#   docker compose pull && docker compose up -d --no-build
# ZSMEET_IMAGE=ghcr.io/zanexo/zsmeet:0.1.0

# ---- 自己构建镜像时用（docker compose build）----
# 国内构建可以换成镜像源
# GOPROXY=https://goproxy.cn,direct
# NPM_REGISTRY=https://registry.npmmirror.com
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
